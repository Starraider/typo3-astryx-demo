options {
    clearCache {
        pages = 1
    }
    pageTree {
        showDomainNameWithTitle = 1
        showPageIdWithTitle = 1
    }
    sites {
        # These sets are already included, therefore hide them in the site configuration set editor
        hideSets := addToList(skom/typo3-astryx,skom/stylex-connector)
    }
}
